<Project>
    <PropertyGroup Label="Common">
        <!-- Target framework version for all projects -->
        <TargetFramework>net10.0</TargetFramework>
        <!-- Language version for all projects -->
        <LangVersion>latestMajor</LangVersion>
        <!-- Enable nullable reference types for all projects -->
        <Nullable>enable</Nullable>
        <!-- Enable implicit usings for all projects -->
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1510;NU1901</WarningsNotAsErrors>
        <!-- Known vulnerabilities (moderate and above) fail the build, including transitive ones -->
        <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Deterministic>true</Deterministic>
        <Authors>Panagiotis Kosmidis</Authors>
        <Copyright>Copyright © Panagiotis Kosmidis</Copyright>
        <Product>Aviant</Product>
        <NeutralLanguage>en-GB</NeutralLanguage>
    </PropertyGroup>

    <PropertyGroup Label="Versioning">
        <!-- Versions come from git tags (v1.2.3); untagged commits get a pre-release height. -->
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    </PropertyGroup>

    <PropertyGroup Label="Packaging">
        <IsPackable>false</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/tecfinity/Aviant</PackageProjectUrl>
        <RepositoryUrl>https://github.com/tecfinity/Aviant</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>ddd;cqrs;event-sourcing;clean-architecture;mediatr;domain-driven-design</PackageTags>
        <Description>Aviant: building blocks for Domain-Driven Design, CQRS and Event Sourcing on .NET.</Description>
    </PropertyGroup>

    <!-- Reproducible builds on CI (SourceLink paths, deterministic output). -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Library projects are packed; tests are not. -->
    <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" PrivateAssets="all" />
    </ItemGroup>
</Project>
