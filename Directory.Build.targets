<Project>
    <!-- Per-module package descriptions. Evaluated after the project, so the module path is known. -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <_AviantModule>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))</_AviantModule>
        <_AviantLayer>$([System.IO.Path]::GetFileName($(MSBuildProjectDirectory)))</_AviantLayer>
        <Description Condition="'$(_AviantModule)' == 'Kernel'">Aviant $(_AviantLayer): the kernel every Aviant module builds on. Entities, commands, queries, the orchestrator and the MediatR pipeline, use cases and cross-cutting registration.</Description>
        <Description Condition="'$(_AviantModule)' == 'DDD'">Aviant DDD $(_AviantLayer): Domain-Driven Design building blocks: aggregates, value objects and domain events.</Description>
        <Description Condition="'$(_AviantModule)' == 'EventSourcing'">Aviant Event Sourcing $(_AviantLayer): event-sourced aggregates, a KurrentDB (EventStoreDB) repository and a Kafka event bus.</Description>
        <Description Condition="'$(_AviantModule)' == 'Persistence'">Aviant Persistence $(_AviantLayer): EF Core read/write contexts, repositories, unit of work and auditing.</Description>
        <Description Condition="'$(_AviantModule)' == 'Identity'">Aviant Identity $(_AviantLayer): ASP.NET Core Identity integration, JWT issuance and audited identity persistence.</Description>
        <Description Condition="'$(_AviantModule)' == 'Email'">Aviant Email $(_AviantLayer): immutable messages, pluggable senders and SMTP delivery over MailKit.</Description>
        <Description Condition="'$(_AviantModule)' == 'MultiTenancy'">Aviant Multi-Tenancy $(_AviantLayer): tenant scope for requests and background jobs, a per-context tenant query filter and write stamping that keeps rows in their tenant.</Description>
        <Description Condition="'$(_AviantModule)' == 'Jobs'">Aviant Jobs $(_AviantLayer): background jobs over Hangfire, with cancellation, recurring jobs and a startup check that every job can be built.</Description>
    </PropertyGroup>

    <!-- Clean removes bin/ and obj/ entirely. -->
    <Target Name="AfterClean">
        <RemoveDir Directories="$(BaseIntermediateOutputPath);$(BaseOutputPath)" />
    </Target>
</Project>
